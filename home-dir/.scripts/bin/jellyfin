#!/bin/bash

# Configuration Variables
readonly MOUNT_ROOT_PATH="/media/"
readonly OMEGA_LOCATION="/run/media/anoop/OMEGA"
readonly JELLYFIN_PORT=8096
readonly JELLYFIN_CONTAINER_NAME="jellyfin"

# Map of source directories to mount locations
declare -A MOUNT_MAP=(
    ["${OMEGA_LOCATION}/Movies/Hollywood"]="hollywood-movies"
    ["${OMEGA_LOCATION}/Movies/Bollywood"]="bollywood-movies"
)

######################################### Utility functions #########################################
# Check if directory does not exist and create it if required
check_and_create_dir() {
    local dir="$1"
    # Check if dir is a device file
    if [[ -b "$dir" || -c "$dir" ]]; then
        echo "$dir is a device file or character device, not a directory."
        return 0
    fi
    if [[ ! -d "$dir" ]]; then
        echo "Creating directory $dir..."
        sudo mkdir -p "$dir"
    fi
}

# Check if podman is installed
check_podman() {
    if ! command -v podman &> /dev/null; then
        echo "Podman is not installed. Please install Podman to use this script."
        exit 1
    fi
}

# Check if mount given mount point is already mounted, mount if not
check_and_mount() {
    local target="$1"
    local mount_point="$2"
    check_and_create_dir "$mount_point"
    if mountpoint -q "$mount_point"; then
        echo "$mount_point is already mounted."
        return 1
    fi
    # Check if target doesn't exist
    if [[ ! -d "$target" ]]; then
        echo "Target directory $target does not exist or not available."
        return 1
    fi
    
    echo "Mounting $target to $mount_point..."
    sudo mount --bind "$target" "$mount_point"
}

# Check and unmount a directory
check_and_unmount() {
    local mount_point="$1"
    if mountpoint -q "$mount_point"; then
        echo "Unmounting $mount_point..."
        sudo umount "$mount_point"
    else
        echo "$mount_point is not mounted. Skipping..."
    fi
}

# Configure firewall rules
configure_firewall() {
    echo "Configuring firewall to allow TCP traffic on port ${JELLYFIN_PORT}..."
    sudo firewall-cmd --add-port=${JELLYFIN_PORT}/tcp
}

# Remove firewall rules
remove_firewall_rules() {
    echo "Removing firewall rule for TCP traffic on port ${JELLYFIN_PORT}..."
    sudo firewall-cmd --remove-port=${JELLYFIN_PORT}/tcp
}

# Temporary
mount_internal_partitions() {
    check_and_mount "/dev/nvme0n1p8" "${ENDEAVOUR_HOME}"
}
######################################### End of utility functions #########################################

############################################## Main functions ##############################################
# Initialize required directories and mounts
initialize_system() {
    check_podman
    echo "Checking and creating required directories..."
    check_and_create_dir "${MOUNT_ROOT_PATH}"
}

# Mount directories based on the map
mount_directories() {
    echo "Mounting directories..."
    for SOURCE in "${!MOUNT_MAP[@]}"; do
        DESTINATION="${MOUNT_ROOT_PATH}${MOUNT_MAP[$SOURCE]}"
        check_and_mount "$SOURCE" "$DESTINATION"
    done
}

# Unmount directories based on the map
unmount_directories() {
    echo "Unmounting directories..."
    for SOURCE in "${!MOUNT_MAP[@]}"; do
        DESTINATION="${MOUNT_ROOT_PATH}${MOUNT_MAP[$SOURCE]}"
        check_and_unmount "$DESTINATION"
    done
}

# Start Jellyfin container
start_jellyfin() {
    echo "Starting Jellyfin service..."
    if podman container exists ${JELLYFIN_CONTAINER_NAME}; then
        podman start ${JELLYFIN_CONTAINER_NAME}
    else
        podman run -d \
            --name ${JELLYFIN_CONTAINER_NAME} \
            -p ${JELLYFIN_PORT}:${JELLYFIN_PORT} \
            -v ~/.config/jellyfin:/config \
            --mount type=bind,source=/media,target=/media \
            --restart=unless-stopped \
            jellyfin/jellyfin
    fi
}

# Stop Jellyfin container
stop_jellyfin() {
    echo "Stopping Jellyfin service..."
    if podman container exists ${JELLYFIN_CONTAINER_NAME}; then
        podman stop ${JELLYFIN_CONTAINER_NAME}
    else
        echo "Jellyfin container does not exist. Nothing to stop."
    fi
}

# Start the complete service
start_service() {
    initialize_system
    mount_internal_partitions
    mount_directories
    start_jellyfin
    configure_firewall
}

# Stop the complete service
stop_service() {
    initialize_system
    stop_jellyfin
    remove_firewall_rules
    unmount_directories
}

mount() {
    initialize_system
    mount_internal_partitions
    mount_directories
}

unmount() {
    initialize_system
    unmount_directories
}

# Display usage information
show_help() {
    cat <<EOF
Usage: $0 {start|stop|mount|unmount|help}

Commands:
  start         Start the complete service (mount directories and start Jellyfin)
  stop          Stop the complete service (stop Jellyfin and unmount directories)
  mount         Only mount directories without starting Jellyfin
  unmount       Only unmount directories without stopping Jellyfin
  help          Show this help message

EOF
}

# Main command dispatcher
main() {
    case "$1" in
        start)
            start_service
            ;;
        stop)
            stop_service
            ;;
        mount)
            mount
            ;;
        unmount)
            unmount
            ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            echo "Error: Unknown command '$1'"
            show_help
            exit 1
            ;;
    esac
}

# Execute main function with arguments
main "$@"